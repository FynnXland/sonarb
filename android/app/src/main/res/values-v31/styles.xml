<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 und neuer: System-Splash mit demselben ruhenden Logo auf dunklem Grund. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/sonar_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/sonar_background</item>
    </style>
</resources>
