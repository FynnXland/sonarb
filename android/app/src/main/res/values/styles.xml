<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fenster beim Prozessstart: dunkler Grund mit Logo, danach zeichnet Flutter das Intro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fenster hinter der Flutter-Oberfläche. Dunkel, damit beim Skalieren nichts aufblitzt. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/sonar_background</item>
    </style>
</resources>
